# ─────────────────────────────────────────────────────────────────────────────
# LearnWithGlinax backend — environment variables
# Copy to `.env` and fill in. Vars marked REQUIRED must be set; the app will
# not start without them. Everything else has a working default.
# ─────────────────────────────────────────────────────────────────────────────

# ─── REQUIRED — core ──────────────────────────────────────────────────────────
# Long random string, 50+ chars (Django rejects short keys with a warning and
# a weak key is a security risk). Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated hosts that may serve the API. On Render: your backend URL.
DJANGO_ALLOWED_HOSTS=your-backend.onrender.com

# PostgreSQL (Render → your database → Internal Database URL pieces; use the
# EXTERNAL hostname + PGSSLMODE=require only when connecting from outside Render).
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your-dbi-host.dbs.render.com
DB_PORT=5432

# Frontend origin — used in welcome-email links.
FRONTEND_URL=https://your-frontend.onrender.com

# Google OAuth client ID (same value the frontend uses). Create at
# console.cloud.google.com → Credentials → OAuth client (Web application),
# with both origins (frontend URL) and redirect URIs authorised.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── REQUIRED — transactional email (Brevo) ───────────────────────────────────
# Brevo account → SMTP & API → API Keys → generate a v3 API key.
# Leave "Authorised IPs" EMPTY when creating it (Render egress IPs change).
# The From address must be a sender verified in your Brevo account.
BREVO_API_KEY=your-brevo-api-key
DEFAULT_FROM_EMAIL=Your Site Name <you@example.com>

# ─── OPTIONAL — analytics (events are queued in event_logs until set) ────────
#POSTHOG_API_KEY=phc_xxx
#POSTHOG_HOST=https://app.posthog.com

# ─── OPTIONAL — error tracking ────────────────────────────────────────────────
#SENTRY_DSN=https://xxx@sentry.io/xxx
#SENTRY_ENVIRONMENT=production
#SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── OPTIONAL — Django admin on your domain ──────────────────────────────────
#CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com

# ─── OPTIONAL — everything below is not needed for a standard deployment ─────
# Redis broker (only if you deploy a Celery worker; the app currently runs
# background tasks inline via INLINE_TASK_DISPATCH in production settings):
#REDIS_URL=redis://default:pass@your-redis:6379
# Legacy SMTP sending (superseded by BREVO_API_KEY above):
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_HOST=smtp-relay.brevo.com
#EMAIL_PORT=587
#EMAIL_USE_TLS=True
#EMAIL_HOST_USER=your-brevo-smtp-login
#EMAIL_HOST_PASSWORD=your-brevo-smtp-key
# Content ingestion only (run once to seed course content; not needed to serve):
#YOUTUBE_API_KEY=xxx
#EDX_CLIENT_ID=xxx
#EDX_CLIENT_SECRET=xxx
#OPENSTAX_API_BASE_URL=https://example.com
