# ─────────────────────────────────────────────────────────────────────────────
# LearnWithGlinax frontend — environment variables (Output/ app)
# Copy to `.env.local` for local development, or set in your hosting provider
# (Render/Vercel dashboard). NEXT_PUBLIC_* values are baked in at BUILD time —
# changing them requires a rebuild.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — backend API base (no trailing slash, must include /api/v1)
NEXT_PUBLIC_API_BASE_URL=https://your-backend.onrender.com/api/v1

# REQUIRED for "Continue with Google" — same Google OAuth client ID the
# backend uses. Email/password sign-up works without it.
# The Google Cloud console "Authorized JavaScript origins" must include your
# frontend URL (e.g. http://localhost:3000 and https://your-frontend.onrender.com).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
